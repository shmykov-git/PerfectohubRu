<UserControl x:Class="MovieIntro.Controls.SlideAddAts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000">

    <Grid>
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
        </Grid.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Основной контент -->
            <StackPanel Grid.Row="0" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Width="500">
                <TextBlock x:Name="WelcomeText"
                           Text="Подключаем облачную АТС"
                           FontFamily="Segoe UI"
                           FontSize="28"
                           FontWeight="Light"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,50,0,40"
                           Opacity="0"/>

                <!-- Поле ввода с круглой кнопкой подсказки -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Поле ввода -->
                    <Border Grid.Column="0" 
                            BorderBrush="#333333" 
                            BorderThickness="1" 
                            Background="#0A0A0A" 
                            Height="55" 
                            CornerRadius="3">
                        <Grid>
                            <TextBox x:Name="TokenTextBox"
                                     Text="{Binding AtsToken, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     FontFamily="Segoe UI"
                                     FontSize="16"
                                     Foreground="#FFFFFF"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="20,0,20,0"
                                     VerticalContentAlignment="Center"
                                     CaretBrush="#FFFFFF">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <Grid>
                                                        <ScrollViewer x:Name="PART_ContentHost" 
                                                                      VerticalAlignment="Center"/>
                                                        <TextBlock Text="Введите АТС токен..."
                                                                   FontFamily="Segoe UI"
                                                                   Foreground="#555555"
                                                                   FontSize="14"
                                                                   VerticalAlignment="Center"
                                                                   Margin="20,0,0,0"
                                                                   IsHitTestVisible="False"
                                                                   Visibility="Collapsed"
                                                                   x:Name="Watermark"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter TargetName="Watermark" 
                                                                    Property="Visibility" 
                                                                    Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <Rectangle x:Name="FocusLine" Height="2" Fill="#FFFFFF" 
                                       VerticalAlignment="Bottom" Opacity="0"
                                       RenderTransformOrigin="0.5,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="0"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <!-- Круглая кнопка подсказки -->
                    <Button x:Name="HelpButton"
                            Grid.Column="1"
                            Width="55" Height="55"
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            Click="HelpButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="#1A1A1A"
                                                    BorderBrush="#333333"
                                                    BorderThickness="1"
                                                    CornerRadius="27.5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#333333"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#666666"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#0A0A0A"/>
                                                    <Setter TargetName="border" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Content">
                                    <Setter.Value>
                                        <TextBlock Text="?" 
                                                   FontFamily="Segoe UI"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#666666"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Стилизованная кнопка Ввести -->
                <Button x:Name="SubmitButton"
                        Content="ВВЕСТИ"
                        Width="200" Height="45"
                        FontFamily="Segoe UI"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#FFFFFF"
                        Background="#1A1A1A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        Cursor="Hand"
                        Opacity="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#333333"/>
                                                <Setter Property="BorderBrush" Value="#666666"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#0A0A0A"/>
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock x:Name="ErrorMessage"
                           Text=""
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#FF4444"
                           HorizontalAlignment="Center"
                           Margin="0,15,0,0"
                           Opacity="0"/>
            </StackPanel>

            <!-- Две картинки в правом нижнем углу -->
            <Border Grid.Row="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10">

                <!-- Картинка-стрелочка (маленькая, указывает на большую) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Маленькая картинка-стрелка -->
                    <Image Grid.Column="0" Grid.Row="0" x:Name="ArrowImage"
                           Source="/Assets/arrow.png"
                           Width="60" Height="60"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="0,0,0,0"
                           Opacity="0">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                        </Image.RenderTransform>
                    </Image>

                    <!-- Большая картинка (результат после подключения) -->
                    <Image Grid.Column="1" Grid.Row="1" x:Name="ResultImage"
                           Source="/Assets/message_example.png"
                           Width="300"
                           Height="200"
                           Stretch="Uniform"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,50,0"
                           Opacity="0">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                        </Image.RenderTransform>
                    </Image>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>