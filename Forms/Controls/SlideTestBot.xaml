<UserControl x:Class="MovieIntro.Controls.SlideTestBot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000"
             Opacity="0"
             >

    <Grid Margin="80,30,80,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="ТЕСТИРУЕМ ЧАТ-БОТА"
                   FontFamily="Segoe UI"
                   FontSize="28"
                   FontWeight="Light"
                   Foreground="#FFFFFF"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,40"/>

        <!-- Пункт 1 -->
        <Grid Grid.Row="1" Margin="0,0,0,20" x:Name="Row1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="28" Height="28"
                    CornerRadius="14"
                    Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <TextBlock Text="1" 
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF3333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="В диалоге чат-бота введите '/start'"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       Foreground="#CCCCCC"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </Grid>

        <!-- Пункт 2 -->
        <Grid Grid.Row="2" Margin="0,0,0,20" x:Name="Row2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="28" Height="28"
                    CornerRadius="14"
                    Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <TextBlock Text="2" 
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF3333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="В появившемся меню проверьте работу сообщения"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       Foreground="#CCCCCC"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </Grid>

        <!-- Пункт 3 -->
        <Grid Grid.Row="3" Margin="0,0,0,20" x:Name="Row3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="28" Height="28"
                    CornerRadius="14"
                    Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <TextBlock Text="3" 
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF3333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="Создайте группу контроля и добавьте в нее чат-бота как администратора (для Max)"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       Foreground="#CCCCCC"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </Grid>

        <!-- Пункт 4 -->
        <Grid Grid.Row="4" Margin="0,0,0,20" x:Name="Row4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="28" Height="28"
                    CornerRadius="14"
                    Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <TextBlock Text="4" 
                           FontFamily="Segoe UI"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#FF3333"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Column="1"
                       Text="Установите расписание получения сообщений"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       Foreground="#CCCCCC"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
        </Grid>

        <!-- Комбобокс с расписанием -->
        <Grid Grid.Row="5" Margin="0,0,0,30" x:Name="Row5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Расписание:"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       Foreground="#CCCCCC"
                       VerticalAlignment="Center"
                       Margin="50,0,15,0"/>

            <ComboBox x:Name="ScheduleComboBox"
          Grid.Column="1"
          Width="200"
          Height="35"
          FontFamily="Segoe UI"
          FontSize="14"
          Foreground="#FFFFFF"
          ItemsSource="{Binding ScheduleItems}"
          SelectedItem="{Binding SelectedSchedule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          SelectionChanged="ScheduleComboBox_SelectionChanged"
          Cursor="Hand">
                <!-- Исправленный шаблон для элементов - убран отдельный Background -->
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" 
                       Foreground="#FFFFFF" 
                       Padding="10,5"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

                <!-- Исправленный стиль контейнера элементов -->
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#000000"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                                        <ContentPresenter HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="10,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#1A1A1A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
        </Grid>

        <!-- Кнопка Готово -->
        <Button     x:Name="DoneButton"
                    Grid.Row="6"
                    Content="ГОТОВО"
                    Width="200" Height="45"
                    FontFamily="Segoe UI"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,0"
                    Click="DoneButton_Click">
        </Button>
    </Grid>
</UserControl>