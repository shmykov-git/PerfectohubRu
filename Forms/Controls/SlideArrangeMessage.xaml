<UserControl x:Class="MovieIntro.Controls.SlideArrangeMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000">
    <UserControl.Resources>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#000000" Opacity="{TemplateBinding Opacity}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="15"/>
                            </Grid.RowDefinitions>

                            <!-- Верхняя кнопка (вверх) -->
                            <RepeatButton x:Name="DecreaseRepeatButton"
                                  Grid.Row="0"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineUpCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,5 L5,0 L10,5 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>

                            <!-- Track с ползунком -->
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                           Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                   Background="#444444"
                                   BorderBrush="#555555"
                                   BorderThickness="1"
                                   Margin="1,0">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Height" Value="40"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3"
                                                            Margin="1,0"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#666666"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#777777"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#999999"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                            <!-- Нижняя кнопка (вниз) -->
                            <RepeatButton x:Name="IncreaseRepeatButton"
                                  Grid.Row="2"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineDownCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,0 L5,5 L10,0 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid x:Name="MainGrid">
        <Grid Margin="40,30,40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Text="СООБЩЕНИЕ"
                       FontFamily="Segoe UI"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,0,30"
                       Opacity="0"/>

            <!-- Основная область: левая и правая половины -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая половина - информационное сообщение -->
                <Border Grid.Column="0"
                        Background="#0A0A0A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Контейнер для кнопки-индикатора (над текстом) -->
                        <Grid Grid.Row="0" Height="0">
                            <!-- Левый индикатор - кнопка с "!" над текстом -->
                            <Button x:Name="LeftIndicatorButton"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Left"
                                    Margin="5,-40,0,0"
                                    Opacity="0"
                                    Cursor="Help"
                                    ToolTipService.InitialShowDelay="300">
                                <Button.ToolTip>
                                    <!-- Здесь ваш собственный сложный ToolTip -->
                                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="300">
                                        <StackPanel>
                                            <TextBlock Text="Сообщение в реальном времени" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FFFFFF"
                                                       FontSize="16"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="Пропущенные вызовы от Ваших клиентов"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"/>
                                            <Border Height="1" 
                                                    Background="#555555" 
                                                    Margin="0,8,0,8"/>
                                            <TextBlock Text="• Настроить сообщение"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                            <TextBlock Text="• Вывести в чат-боте"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                            <TextBlock Text="• Вывести в 1С"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="28"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Content" Value="!"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button x:Name="RefreshMessageButton"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Left"
                                    Margin="35,-40,0,0"
                                    Opacity="0"                                    
                                    Cursor="Help"
                                    Click="RefreshMessageButton_Click"
                                    ToolTipService.InitialShowDelay="300">
                                <Button.ToolTip>
                                    <!-- Здесь ваш собственный сложный ToolTip -->
                                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="300">
                                        <StackPanel>
                                            <TextBlock Text="Нажмите, чтобы обновить сообщение" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FFFFFF"
                                                       FontSize="14"
                                                       Margin="0,0,0,5"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="28"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#444444"/>
                                                            <Setter TargetName="b" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>                                                
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Content" Value="↻"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="InfoMessageText"
                                       Text="{Binding CallsMessage, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       Foreground="#FFFFFF"
                                       TextWrapping="Wrap"
                                       TextAlignment="Left"
                                       Padding="15,15,15,15"
                                       Opacity="0"
                                       LineHeight="22">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Разделитель -->
                <Border Grid.Column="1"
                        Background="#333333"
                        Width="1"
                        VerticalAlignment="Stretch"
                        Margin="0,10,0,10"/>

                <!-- Правая половина - поле для ввода текста -->
                <Border Grid.Column="2"
                        Background="#0A0A0A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Контейнер для кнопки-индикатора (над текстом) -->
                        <Grid Grid.Row="0" Height="0">
                            <!-- Правый индикатор - кнопка с "!" над текстом -->
                            <Button x:Name="CommonsIndicatorButton"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    Margin="0,-40,5,0"
                                    Opacity="0"
                                    Cursor="Help"
                                    ToolTipService.InitialShowDelay="300">
                                <Button.ToolTip>
                                    <!-- Здесь ваш собственный сложный ToolTip -->
                                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="400">
                                        <StackPanel>
                                            <TextBlock Text="Общие телефоны" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FFFFFF"
                                                       FontSize="16"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="Список общих телефонов АТС"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"/>
                                            <Border Height="1" 
                                                    Background="#555555" 
                                                    Margin="0,8,0,8"/>
                                            <TextBlock Text="• 4001"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                            <TextBlock Text="• 201"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                            <TextBlock Text="• ..."
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="28"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Content" Value="!"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button x:Name="SaveCommonsButton"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    Margin="0,-40,35,0"
                                    Opacity="0"
                                    Cursor="Help"
                                    Click="SaveCommonsButton_Click"
                                    ToolTipService.InitialShowDelay="400">
                                <Button.ToolTip>
                                    <!-- Здесь ваш собственный сложный ToolTip -->
                                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="400">
                                        <StackPanel>
                                            <TextBlock Text="Нажмите, чтобы сохранить общие телефоны" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FFFFFF"
                                                       FontSize="14"
                                                       Margin="0,0,0,5"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="28"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#444444"/>
                                                            <Setter TargetName="b" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Content" Value="💾"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <TextBox x:Name="CommonsTextBox"
                                 Grid.Row="1"
                                 Text="{Binding Commons, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 FontFamily="Segoe UI"
                                 FontSize="14"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="15,15,15,15"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Opacity="0"
                                 CaretBrush="#FFFFFF">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                            </TextBox.RenderTransform>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  VerticalScrollBarVisibility="Auto"/>
                                                    <TextBlock Text="...&#x0a;567890&#x0a;4001&#x0a;201&#x0a;..."
                                                               FontFamily="Segoe UI"
                                                               Foreground="#999999"
                                                               FontSize="14"
                                                               Padding="15,12,0,0"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed"
                                                               x:Name="Watermark"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Watermark" 
                                                                Property="Visibility" 
                                                                Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Анимированная линия фокуса -->
                        <Rectangle x:Name="CommonsFocusLine" 
                                   Grid.Row="1"
                                   Height="2" 
                                   Fill="#777777" 
                                   VerticalAlignment="Bottom" 
                                   Opacity="0"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Border>
                
                <!-- Разделитель -->
                <Border Grid.Column="3"
                        Background="#333333"
                        Width="1"
                        VerticalAlignment="Stretch"
                        Margin="0,10,0,10"/>

                <!-- Правая половина - поле для ввода текста -->
                <Border Grid.Column="4"
                        Background="#0A0A0A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Контейнер для кнопки-индикатора (над текстом) -->
                        <Grid Grid.Row="0" Height="0">
                            <!-- Правый индикатор - кнопка с "!" над текстом -->
                            <Button x:Name="KnownsIndicatorButton"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    Margin="0,-40,5,0"
                                    Opacity="0"
                                    Cursor="Help"
                                    ToolTipService.InitialShowDelay="300">
                                <Button.ToolTip>
                                    <!-- Здесь ваш собственный сложный ToolTip -->
                                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="400">
                                        <StackPanel>
                                            <TextBlock Text="Исключенные из сообщения телефоны" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FFFFFF"
                                                       FontSize="16"
                                                       Margin="0,0,0,5"/>
                                            <TextBlock Text="Список телефонов НЕ клиентов"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"/>
                                            <Border Height="1" 
                                                    Background="#555555" 
                                                    Margin="0,8,0,8"/>
                                            <TextBlock Text="• Ваш личный телефон"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                            <TextBlock Text="• Личный телефон сотрудника"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                            <TextBlock Text="• Телефон водителя"
                                                       Foreground="#DDDDDD"
                                                       FontSize="14"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="28"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Content" Value="!"/>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="SaveKnownsButton"
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Right"
                                    Margin="0,-40,35,0"
                                    Opacity="0"
                                    Cursor="Help"
                                    Click="SaveKnownsButton_Click"
                                    ToolTipService.InitialShowDelay="300">
                                <Button.ToolTip>
                                    <!-- Здесь ваш собственный сложный ToolTip -->
                                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="500">
                                        <StackPanel>
                                            <TextBlock Text="Нажмите, чтобы сохранить исключенные телефоны" 
                                                       FontWeight="Bold" 
                                                       Foreground="#FFFFFF"
                                                       FontSize="14"
                                                       Margin="0,0,0,5"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="28"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="b" Property="Background" Value="#444444"/>
                                                            <Setter TargetName="b" Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="14"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Content" Value="💾"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <TextBox x:Name="KnownsTextBox"
                                 Grid.Row="1"
                                 Text="{Binding Knowns, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 FontFamily="Segoe UI"
                                 FontSize="14"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="15,15,15,15"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Opacity="0"
                                 CaretBrush="#FFFFFF">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                            </TextBox.RenderTransform>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  VerticalScrollBarVisibility="Auto"/>
