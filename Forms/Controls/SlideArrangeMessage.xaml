<UserControl x:Class="MovieIntro.Controls.SlideArrangeMessage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000">

    <Grid>
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
        </Grid.RenderTransform>

        <Grid Margin="40,30,40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock x:Name="TitleText"
                       Grid.Row="0"
                       Text="СООБЩЕНИЕ"
                       FontFamily="Segoe UI"
                       FontSize="28"
                       FontWeight="Light"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       Opacity="0"/>

            <!-- Основная область: левая и правая половины -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левая половина - информационное сообщение (только для чтения) -->
                <Border Grid.Column="0"
                        Background="#0A0A0A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="InfoMessageText"
                                   FontFamily="Segoe UI"
                                   FontSize="14"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap"
                                   TextAlignment="Left"
                                   Padding="15"
                                   LineHeight="22"
                                   Opacity="0">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </ScrollViewer>
                </Border>

                <!-- Разделитель -->
                <Border Grid.Column="1"
                        Background="#333333"
                        Width="1"
                        VerticalAlignment="Stretch"
                        Margin="0,10,0,10"/>

                <!-- Правая половина - поле для ввода текста -->
                <Border Grid.Column="2"
                        Background="#0A0A0A"
                        BorderBrush="#333333"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <TextBox x:Name="InputTextBox"
                                 FontFamily="Segoe UI"
                                 FontSize="14"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="15"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 CaretBrush="#FFFFFF"
                                 Opacity="0">
                            <TextBox.RenderTransform>
                                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                            </TextBox.RenderTransform>
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  VerticalScrollBarVisibility="Auto"/>
                                                    <TextBlock Text="Введите текст..."
                                                               FontFamily="Segoe UI"
                                                               Foreground="#555555"
                                                               FontSize="14"
                                                               Padding="15,12,0,0"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed"
                                                               x:Name="Watermark"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Watermark" 
                                                                Property="Visibility" 
                                                                Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Анимированная линия фокуса -->
                        <Rectangle x:Name="FocusLine" 
                                   Height="2" 
                                   Fill="#FF3333" 
                                   VerticalAlignment="Bottom" 
                                   Opacity="0"
                                   RenderTransformOrigin="0.5,0.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform ScaleX="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Border>
            </Grid>

            <!-- Кнопка Готово -->
            <Button x:Name="DoneButton"
                    Grid.Row="2"
                    Content="ГОТОВО"
                    Width="180" Height="45"
                    FontFamily="Segoe UI"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="#FFFFFF"
                    Background="#1A1A1A"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    Cursor="Hand"
                    HorizontalAlignment="Center"
                    Margin="0,30,0,0"
                    Opacity="0"
                    Click="DoneButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Setter Property="BorderBrush" Value="#666666"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#0A0A0A"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</UserControl>