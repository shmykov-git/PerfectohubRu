<Window x:Class="MovieIntro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MovieIntro.Controls"
        Title="Movie Intro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.png"
        Width="900" Height="550">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="#000000"
                                          BorderBrush="#333333"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Border"
                                                            Background="#000000"
                                                            BorderBrush="#333333"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       x:Name="SelectedText"
                                                                       Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                       Foreground="#FFFFFF"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0"/>
                                                            <Path Grid.Column="1"
                                                                  x:Name="Arrow"
                                                                  Data="M0,0 L5,5 L10,0 Z"
                                                                  Fill="#666666"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,2,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#1A1A1A"/>
                                                            <Setter TargetName="Arrow" Property="Fill" Value="#999999"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <!-- Исправленный Popup с черным фоном -->
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Width="200"
                                   PopupAnimation="Fade">
                                <Border Background="#000000"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                    <ScrollViewer x:Name="ScrollViewer"
                                                  MaxHeight="200"
                                                  Background="#000000"
                                                  BorderThickness="0">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElement"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#333333"/>
                                <Setter TargetName="BorderElement" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.95,0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#000000" Opacity="{TemplateBinding Opacity}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="15"/>
                            </Grid.RowDefinitions>

                            <!-- Верхняя кнопка (вверх) -->
                            <RepeatButton x:Name="DecreaseRepeatButton"
                                  Grid.Row="0"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineUpCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,5 L5,0 L10,5 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>

                            <!-- Track с ползунком -->
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                           Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                   Background="#444444"
                                   BorderBrush="#555555"
                                   BorderThickness="1"
                                   Margin="1,0">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Height" Value="40"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3"
                                                            Margin="1,0"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#666666"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#777777"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#999999"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                            <!-- Нижняя кнопка (вниз) -->
                            <RepeatButton x:Name="IncreaseRepeatButton"
                                  Grid.Row="2"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineDownCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,0 L5,5 L10,0 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" x:Name="OuterCircle" 
                                                                Width="14" Height="14" 
                                                                Stroke="#666666" 
                                                                Fill="Transparent"/>
                            <Ellipse Grid.Column="0" x:Name="InnerCircle" 
                                                                Width="8" Height="8" 
                                                                Fill="#AA3333" 
                                                                Visibility="Collapsed"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"  Content="{TemplateBinding Content}"
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#AA3333"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Border Background="#0A0A0A" 
            CornerRadius="8"             
            BorderBrush="#333333" 
            BorderThickness="1"
            >
        <Grid Margin="4">
            <!-- Контейнер для слайдов -->
            <Grid x:Name="SlidesContainer">
                <controls:Slide1 x:Name="Slide1Control"/>
                <controls:Slide2 x:Name="Slide2Control" Visibility="Collapsed"/>
                <controls:Slide3 x:Name="Slide3Control" Visibility="Collapsed"/>
                <controls:Slide4 x:Name="SlideCallsInfoControl" Visibility="Collapsed"/>
                <controls:SlideAddAts x:Name="SlideAddAtsControl" Visibility="Collapsed"/>
                <controls:SlideArrangeMessage x:Name="SlideArrangeMessageControl" Visibility="Collapsed"/>
                <controls:SlideAddBot x:Name="SlideAddBotControl" Visibility="Collapsed"/>
                <controls:SlideTestBot x:Name="SlideTestBotControl" Visibility="Collapsed"/>
                <controls:SlideIntegration x:Name="SlideIntegrationControl" Visibility="Collapsed"/>
            </Grid>

            <!-- Заголовок для перетаскивания (область без кнопок) -->
            <Border x:Name="TitleBar"
                    Height="40"
                    Background="Transparent"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <!-- Кнопки управления окном -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,10,0">

                <!-- Кнопка Свернуть -->
                <Button x:Name="MinimizeButton"
                        Width="30" Height="30"
                        Margin="5,0,5,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click">
                    <Button.Content>
                        <Grid Width="16" Height="16">
                            <Rectangle Fill="#666666" 
                                       Width="16" Height="2" 
                                       VerticalAlignment="Bottom" 
                                       Margin="0,0,0,4"/>
                        </Grid>
                    </Button.Content>
                </Button>

                <!-- Кнопка Закрыть -->
                <Button x:Name="CloseButton"
                        Width="30" Height="30"
                        Margin="5,0,0,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click">
                    <Button.Content>
                        <Grid Width="16" Height="16">
                            <Line X1="2" Y1="2" X2="14" Y2="14" 
                                  Stroke="#666666" StrokeThickness="2" 
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="14" Y1="2" X2="2" Y2="14" 
                                  Stroke="#666666" StrokeThickness="2" 
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button.Content>
                </Button>
            </StackPanel>

            <!-- Индикаторы слайдов -->
            <StackPanel x:Name="Indicators"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,20">
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.5" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
            </StackPanel>

            <!-- perfectohub.ru -->
            <StackPanel x:Name="Logo"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="20,20,20,20"
                        Opacity="0">
                <TextBlock Text="perfectohub.ru" 
                   Foreground="#FFFFFF" 
                   Background="Transparent"
                   FontFamily="Segoe UI"
                   FontSize="14"
                   Cursor="Hand"
                   TextDecorations="Underline"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MouseLeftButtonDown="Hyperlink_Click"
                   Opacity="0.8" />
            </StackPanel>

            <!-- support -->
            <StackPanel x:Name="Support"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="20,20,20,20"
                        Opacity="0">
                <Button x:Name="StatusButton"
                        FontSize="16"
                Width="25" Height="25"
                Background="Transparent"
                        Foreground="#CCCCCC"
                BorderThickness="0"
                        Content="⚙️"
                Cursor="Hand"
                Click="StatusButton_Click"/>
            </StackPanel>

            <Button x:Name="MovePrevButton"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="5,20,20,20"
                                    Opacity="0"
                                    Cursor="Hand"
                                    IsEnabled="false"
                                    Click="MovePrevButton_Click"
                                    ToolTipService.InitialShowDelay="300">
                <Button.ToolTip>
                    <!-- Здесь ваш собственный сложный ToolTip -->
                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="300">
                        <StackPanel>
                            <TextBlock Text="🠜 к предыдущему слайду" 
                                FontWeight="Bold" 
                                Foreground="#FFFFFF"
                                FontSize="16"
                                Margin="0,0,0,5"/>
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="30"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#444444"/>
                                            <Setter TargetName="b" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Content" Value="🠜"/>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="MoveNextButton"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="20,20,5,20"
                                    Opacity="0"
                                    Cursor="Hand"
                                    IsEnabled="false"
                                    Click="MoveNextButton_Click"
                                    ToolTipService.InitialShowDelay="300">
                <Button.ToolTip>
                    <!-- Здесь ваш собственный сложный ToolTip -->
                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="300">
                        <StackPanel>
                            <TextBlock Text="к следующему слайду 🠞" 
                                FontWeight="Bold" 
                                Foreground="#FFFFFF"
                                FontSize="16"
                                Margin="0,0,0,5"/>
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="30"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#444444"/>
                                            <Setter TargetName="b" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Content" Value="🠞"/>
                    </Style>
                </Button.Style>
            </Button>

        </Grid>
    </Border>
</Window>