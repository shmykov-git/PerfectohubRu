<Window x:Class="MovieIntro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MovieIntro.Controls"
        Title="Movie Intro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.png"
        Width="900" Height="550">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#000000" CornerRadius="0">
        <Grid>
            <!-- Контейнер для слайдов -->
            <Grid x:Name="SlidesContainer">
                <controls:Slide1 x:Name="Slide1Control"/>
                <controls:Slide2 x:Name="Slide2Control" Visibility="Collapsed"/>
                <controls:Slide3 x:Name="Slide3Control" Visibility="Collapsed"/>
                <controls:Slide4 x:Name="SlideCallsInfoControl" Visibility="Collapsed"/>
                <controls:SlideAddAts x:Name="SlideAddAtsControl" Visibility="Collapsed"/>
                <controls:SlideArrangeMessage x:Name="SlideArrangeMessageControl" Visibility="Collapsed"/>
            </Grid>

            <!-- Заголовок для перетаскивания (область без кнопок) -->
            <Border x:Name="TitleBar"
                    Height="40"
                    Background="Transparent"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <!-- Кнопки управления окном -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,10,0">

                <!-- Кнопка Свернуть -->
                <Button x:Name="MinimizeButton"
                        Width="30" Height="30"
                        Margin="5,0,5,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click">
                    <Button.Content>
                        <Grid Width="16" Height="16">
                            <Rectangle Fill="#666666" 
                                       Width="16" Height="2" 
                                       VerticalAlignment="Bottom" 
                                       Margin="0,0,0,4"/>
                        </Grid>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Grid Width="16" Height="16">
                                                <Rectangle Fill="#999999" 
                                                           Width="16" Height="2" 
                                                           VerticalAlignment="Bottom" 
                                                           Margin="0,0,0,4"/>
                                            </Grid>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Кнопка Закрыть -->
                <Button x:Name="CloseButton"
                        Width="30" Height="30"
                        Margin="5,0,0,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click">
                    <Button.Content>
                        <Grid Width="16" Height="16">
                            <Line X1="2" Y1="2" X2="14" Y2="14" 
                                  Stroke="#666666" StrokeThickness="2" 
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="14" Y1="2" X2="2" Y2="14" 
                                  Stroke="#666666" StrokeThickness="2" 
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Grid Width="16" Height="16">
                                                <Line X1="2" Y1="2" X2="14" Y2="14" 
                                                      Stroke="#FF3333" StrokeThickness="2" 
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="14" Y1="2" X2="2" Y2="14" 
                                                      Stroke="#FF3333" StrokeThickness="2" 
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Индикаторы слайдов -->
            <StackPanel x:Name="Indicators"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,20">
                <Ellipse x:Name="Indicator1" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.5" Margin="5"/>
                <Ellipse x:Name="Indicator2" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse x:Name="Indicator3" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse x:Name="Indicator4" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse x:Name="Indicator5" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse x:Name="Indicator6" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
            </StackPanel>

            <!-- perfectohub.ru -->
            <StackPanel x:Name="Logo"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="20,20,20,20"
                        Opacity="0">
                <TextBlock Text="perfectohub.ru" 
           Foreground="#FFFFFF" 
            Opacity="0.5"
           Background="Transparent"
           FontFamily="Segoe UI"
           FontSize="14"
           Cursor="Hand"
           TextDecorations="Underline"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           MouseLeftButtonDown="Hyperlink_Click"/>
            </StackPanel>

            <!-- support -->
            <StackPanel x:Name="Support"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="20,20,20,20"
                        Opacity="0">
                <Button x:Name="ChatButton"
                Width="25" Height="25"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="ChatButton_Click">
                    <Image Source="/Assets/chat.png" Width="25" Height="25" Opacity="0.5"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>