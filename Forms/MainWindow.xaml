<Window x:Class="MovieIntro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MovieIntro.Controls"
        Title="Movie Intro"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/logo.png"
        Width="900" Height="550">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0A0A0A" 
            CornerRadius="8"             
            BorderBrush="#333333" 
            BorderThickness="1"
            >
        <Grid Margin="4">
            <!-- Контейнер для слайдов -->
            <Grid x:Name="SlidesContainer">
                <controls:Slide1 x:Name="Slide1Control"/>
                <controls:Slide2 x:Name="Slide2Control" Visibility="Collapsed"/>
                <controls:Slide3 x:Name="Slide3Control" Visibility="Collapsed"/>
                <controls:Slide4 x:Name="SlideCallsInfoControl" Visibility="Collapsed"/>
                <controls:SlideAddAts x:Name="SlideAddAtsControl" Visibility="Collapsed"/>
                <controls:SlideArrangeMessage x:Name="SlideArrangeMessageControl" Visibility="Collapsed"/>
                <controls:SlideAddBot x:Name="SlideAddBotControl" Visibility="Collapsed"/>
                <controls:SlideTestBot x:Name="SlideTestBotControl" Visibility="Collapsed"/>
                <controls:SlideIntegration x:Name="SlideIntegrationControl" Visibility="Collapsed"/>
            </Grid>

            <!-- Заголовок для перетаскивания (область без кнопок) -->
            <Border x:Name="TitleBar"
                    Height="40"
                    Background="Transparent"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Stretch"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <!-- Кнопки управления окном -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,10,10,0">

                <!-- Кнопка Свернуть -->
                <Button x:Name="MinimizeButton"
                        Width="30" Height="30"
                        Margin="5,0,5,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MinimizeButton_Click">
                    <Button.Content>
                        <Grid Width="16" Height="16">
                            <Rectangle Fill="#666666" 
                                       Width="16" Height="2" 
                                       VerticalAlignment="Bottom" 
                                       Margin="0,0,0,4"/>
                        </Grid>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Grid Width="16" Height="16">
                                                <Rectangle Fill="#999999" 
                                                           Width="16" Height="2" 
                                                           VerticalAlignment="Bottom" 
                                                           Margin="0,0,0,4"/>
                                            </Grid>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Кнопка Закрыть -->
                <Button x:Name="CloseButton"
                        Width="30" Height="30"
                        Margin="5,0,0,0"
                        Cursor="Hand"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_Click">
                    <Button.Content>
                        <Grid Width="16" Height="16">
                            <Line X1="2" Y1="2" X2="14" Y2="14" 
                                  Stroke="#666666" StrokeThickness="2" 
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="14" Y1="2" X2="2" Y2="14" 
                                  Stroke="#666666" StrokeThickness="2" 
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Button.Content>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Opacity" Value="0.6"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <Grid Width="16" Height="16">
                                                <Line X1="2" Y1="2" X2="14" Y2="14" 
                                                      Stroke="#FF3333" StrokeThickness="2" 
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Line X1="14" Y1="2" X2="2" Y2="14" 
                                                      Stroke="#FF3333" StrokeThickness="2" 
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Grid>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- Индикаторы слайдов -->
            <StackPanel x:Name="Indicators"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,20">
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.5" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
                <Ellipse Width="8" Height="8" Fill="#FFFFFF" Opacity="0.2" Margin="5"/>
            </StackPanel>

            <!-- perfectohub.ru -->
            <StackPanel x:Name="Logo"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="20,20,20,20"
                        Opacity="0">
                <TextBlock Text="perfectohub.ru" 
                   Foreground="#FFFFFF" 
                   Background="Transparent"
                   FontFamily="Segoe UI"
                   FontSize="14"
                   Cursor="Hand"
                   TextDecorations="Underline"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   MouseLeftButtonDown="Hyperlink_Click"
                   Opacity="0.8" />
            </StackPanel>

            <!-- support -->
            <StackPanel x:Name="Support"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="20,20,20,20"
                        Opacity="0">
                <Button x:Name="ChatButton"
                Width="25" Height="25"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="ChatButton_Click">
                    <Image Source="/Assets/chat.png" Width="25" Height="25" Opacity="0.8"/>
                </Button>
            </StackPanel>

            <Button x:Name="MovePrevButton"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="5,20,20,20"
                                    Opacity="0"
                                    Cursor="Hand"
                                    IsEnabled="false"
                                    Click="MovePrevButton_Click"
                                    ToolTipService.InitialShowDelay="300">
                <Button.ToolTip>
                    <!-- Здесь ваш собственный сложный ToolTip -->
                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="300">
                        <StackPanel>
                            <TextBlock Text="🠜 к предыдущему слайду" 
                                FontWeight="Bold" 
                                Foreground="#FFFFFF"
                                FontSize="16"
                                Margin="0,0,0,5"/>
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="30"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#444444"/>
                                            <Setter TargetName="b" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Content" Value="🠜"/>
                    </Style>
                </Button.Style>
            </Button>

            <Button x:Name="MoveNextButton"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="20,20,5,20"
                                    Opacity="0"
                                    Cursor="Hand"
                                    IsEnabled="false"
                                    Click="MoveNextButton_Click"
                                    ToolTipService.InitialShowDelay="300">
                <Button.ToolTip>
                    <!-- Здесь ваш собственный сложный ToolTip -->
                    <ToolTip Background="#333333" 
                                             BorderBrush="#555555"
                                             BorderThickness="1"
                                             Padding="10"
                                             MaxWidth="300">
                        <StackPanel>
                            <TextBlock Text="к следующему слайду 🠞" 
                                FontWeight="Bold" 
                                Foreground="#FFFFFF"
                                FontSize="16"
                                Margin="0,0,0,5"/>
                        </StackPanel>
                    </ToolTip>
                </Button.ToolTip>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="#000000"
                                                            CornerRadius="30"
                                                            BorderBrush="#777777"
                                                            BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#777777"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#444444"/>
                                            <Setter TargetName="b" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="FontFamily" Value="Segoe UI"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#FFFFFF"/>
                        <Setter Property="Content" Value="🠞"/>
                    </Style>
                </Button.Style>
            </Button>

        </Grid>
    </Border>
</Window>