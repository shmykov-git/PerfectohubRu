<Window x:Class="MovieIntro.SupportChat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат поддержки"
        WindowStartupLocation="Manual"
        Width="400" Height="550"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElement"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#333333"/>
                                <Setter TargetName="BorderElement" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.95,0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#000000" Opacity="{TemplateBinding Opacity}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="15"/>
                            </Grid.RowDefinitions>

                            <!-- Верхняя кнопка (вверх) -->
                            <RepeatButton x:Name="DecreaseRepeatButton"
                                  Grid.Row="0"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineUpCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,5 L5,0 L10,5 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>

                            <!-- Track с ползунком -->
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                           Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                   Background="#444444"
                                   BorderBrush="#555555"
                                   BorderThickness="1"
                                   Margin="1,0">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Height" Value="40"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3"
                                                            Margin="1,0"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#666666"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#777777"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#999999"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                            <!-- Нижняя кнопка (вниз) -->
                            <RepeatButton x:Name="IncreaseRepeatButton"
                                  Grid.Row="2"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineDownCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,0 L5,5 L10,0 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" x:Name="OuterCircle" 
                                                                Width="14" Height="14" 
                                                                Stroke="#666666" 
                                                                Fill="Transparent"/>
                            <Ellipse Grid.Column="0" x:Name="InnerCircle" 
                                                                Width="8" Height="8" 
                                                                Fill="#AA3333" 
                                                                Visibility="Collapsed"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"  Content="{TemplateBinding Content}"
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#AA3333"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0A0A0A" 
            BorderBrush="#333333" 
            BorderThickness="1"
            CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с кнопкой закрытия -->
            <Border Grid.Row="0" 
                    Background="#0A0A0A" 
                    CornerRadius="8,8,0,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="💬" FontSize="16" Foreground="#FF3333" Margin="0,0,8,0"/>
                        <TextBlock Text="ЧАТ ПОДДЕРЖКИ" 
                                   FontFamily="Segoe UI"
                                   FontSize="13" 
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click">
                        <Button.Content>
                            <Grid Width="12" Height="12">
                                <Line X1="0" Y1="0" X2="12" Y2="12" 
                                      Stroke="#666666" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="12" Y1="0" X2="0" Y2="12" 
                                      Stroke="#666666" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Grid Width="12" Height="12">
                                                    <Line X1="0" Y1="0" X2="12" Y2="12" 
                                                          Stroke="#FF3333" StrokeThickness="2" 
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    <Line X1="12" Y1="0" X2="0" Y2="12" 
                                                          Stroke="#FF3333" StrokeThickness="2" 
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                </Grid>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Область чата -->
            <Grid Grid.Row="1" Margin="15,10,15,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Список сообщений -->
                <ListBox x:Name="MessagesListBox"
                         Grid.Row="1"
                         Background="#0D0D0D"
                         BorderBrush="#333333"
                         BorderThickness="1"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="5,5,5,5" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1A1A1A"/>
                                        <Setter Property="Margin" Value="5,5,20,5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUserMessage}" Value="True">
                                                <Setter Property="Background" Value="#2A1A1A"/>
                                                <Setter Property="Margin" Value="20,5,5,5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <TextBlock Text="{Binding Sender}"
                                               FontFamily="Segoe UI"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#888888"
                                               Margin="8,5,8,0"/>
                                    <TextBlock Text="{Binding Message}"
                                               FontFamily="Segoe UI"
                                               FontSize="12"
                                               Foreground="#FFFFFF"
                                               TextWrapping="Wrap"
                                               Margin="8,2,8,5"/>
                                    <TextBlock Text="{Binding Time}"
                                               FontFamily="Segoe UI"
                                               FontSize="9"
                                               Foreground="#555555"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,8,5"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Нижняя панель с вводом сообщения -->
            <Border Grid.Row="2" 
                    Background="#0D0D0D" 
                    CornerRadius="0,0,8,8"
                    Padding="15,10,15,15">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Поле ввода сообщения -->
                    <Border Grid.Column="0" 
                            BorderBrush="#333333" 
                            BorderThickness="1" 
                            Background="#0A0A0A" 
                            CornerRadius="4"
                            Margin="0,0,10,0">
                        <TextBox x:Name="MessageTextBox"
                                 FontFamily="Segoe UI"
                                 FontSize="13"
                                 Foreground="#FFFFFF"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="12,10,12,10"
                                 MinHeight="36"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 CaretBrush="#FFFFFF"
                                 KeyDown="MessageTextBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <ScrollViewer x:Name="PART_ContentHost" 
                                                                  VerticalAlignment="Center"/>
                                                    <TextBlock Text="Введите сообщение..."
                                                               FontFamily="Segoe UI"
                                                               Foreground="#555555"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Margin="12,0,0,0"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed"
                                                               x:Name="Watermark"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter TargetName="Watermark" 
                                                                Property="Visibility" 
                                                                Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <!-- Кнопка Отправить -->
                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Width="48" Height="36"
                            Cursor="Hand"
                            Background="#1A1A1A"
                            BorderBrush="#FF3333"
                            BorderThickness="1"
                            Focusable="false"
                            Click="SendButton_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➤" FontSize="12" Foreground="#FF3333" Margin="0,0,5,0"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>