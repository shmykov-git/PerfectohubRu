<Window x:Class="MovieIntro.AtsHelpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Облачные АТС"
        WindowStartupLocation="CenterOwner"
        Width="650" Height="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Основной контейнер с черным фоном и светлой окантовкой -->
    <Border Background="#0A0A0A" 
            BorderBrush="#333333" 
            CornerRadius="8"
            BorderThickness="1">

        <Grid Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с кнопкой закрытия -->
            <Border Grid.Row="0" 
                    Background="#0A0A0A" 
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="ℹ️ ОБЛАЧНЫЕ АТС"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"/>

                    <!-- Кнопка закрытия -->
                    <Button x:Name="CloseButton"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click">
                        <Button.Content>
                            <Grid Width="12" Height="12">
                                <Line X1="0" Y1="0" X2="12" Y2="12" 
                                      Stroke="#666666" StrokeThickness="2"/>
                                <Line X1="12" Y1="0" X2="0" Y2="12" 
                                      Stroke="#666666" StrokeThickness="2"/>
                            </Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Content">
                                            <Setter.Value>
                                                <Grid Width="12" Height="12">
                                                    <Line X1="0" Y1="0" X2="12" Y2="12" 
                                                          Stroke="#FF3333" StrokeThickness="2"/>
                                                    <Line X1="12" Y1="0" X2="0" Y2="12" 
                                                          Stroke="#FF3333" StrokeThickness="2"/>
                                                </Grid>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Основное содержимое -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,15,20,20">

                    <!-- Пояснительный текст -->
                    <TextBlock Text="Нам потребуется облачная АТС для контроля звонков:"
                               FontFamily="Segoe UI"
                               FontSize="13"
                               Foreground="#CCCCCC"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               LineHeight="20"/>

                    <!-- Список преимуществ -->
                    <StackPanel Margin="10,0,0,20">
                        <TextBlock Text="✓ Контролируем все вызовы сотрудников"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="#AAAAAA"
                                   Margin="0,3,0,3"/>
                        <TextBlock Text="✓ Формируем единое сообщение о пропущеных вызовах"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="#AAAAAA"
                                   Margin="0,3,0,3"/>
                        <TextBlock Text="✓ Выводим сообщение в удобном месте"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="#AAAAAA"
                                   Margin="0,3,0,3"/>
                        <TextBlock Text="✓ Интегрируем с 1С"
                                   FontFamily="Segoe UI"
                                   FontSize="13"
                                   Foreground="#AAAAAA"
                                   Margin="0,3,0,3"/>
                    </StackPanel>

                    <!-- Разделитель -->
                    <Rectangle Height="1" Fill="#333333" Margin="0,0,0,20"/>

                    <TextBlock Text="ВЫБЕРИТЕ ПРОВАЙДЕРА"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- Карточки провайдеров -->
                    <Grid Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Билайн -->
                        <Border Grid.Column="0"
                                Background="#0D0D0D"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="BeelineLink_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                            <Setter Property="BorderBrush" Value="#666666"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Margin="20,15,20,15">
                                <TextBlock Text="📞" 
                                           FontSize="48" 
                                           HorizontalAlignment="Center"
                                           Foreground="#DD3333"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="БИЛАЙН"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Облачная АТС"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="#888888"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Tele2 -->
                        <Border Grid.Column="2"
                                Background="#0D0D0D"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                CornerRadius="8"
                                Cursor="Hand"
                                MouseLeftButtonDown="Tele2Link_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A1A1A"/>
                                            <Setter Property="BorderBrush" Value="#666666"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel Margin="20,15,20,15">
                                <TextBlock Text="📞" 
                                           FontSize="48" 
                                           HorizontalAlignment="Center"
                                           Foreground="#DD3333"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="TELE2"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,5"/>
                                <TextBlock Text="Облачная АТС"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           Foreground="#888888"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="Выберете провайдера, настройте, подключите API, скопируйте токен (access token)"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#666666"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>