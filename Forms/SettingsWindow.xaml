<Window x:Class="MovieIntro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="650" Height="550"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#0A0A0A" 
            BorderBrush="#333333" 
            BorderThickness="1"
            CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с кнопкой закрытия -->
            <Border Grid.Row="0" 
                    Background="#0A0A0A" 
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Border x:Name="TitleBar"
                        Height="40"
                        Background="Transparent"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                    <StackPanel 
                        Orientation="Horizontal" 
                        Margin="15,0,0,0" 
                        VerticalAlignment="Center" 
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="⚙" FontSize="16" Foreground="#888888" Margin="0,0,8,0"/>
                        <TextBlock Text="НАСТРОЙКИ" 
                                   FontFamily="Segoe UI"
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button x:Name="CloseButton"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click">
                        <Button.Content>
                            <Grid Width="12" Height="12">
                                <Line X1="0" Y1="0" X2="12" Y2="12" 
                                      Stroke="#666666" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="12" Y1="0" X2="0" Y2="12" 
                                      Stroke="#666666" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

            <!-- Основное содержимое: две колонки -->
            <Grid Grid.Row="1" Margin="20,15,20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ЧАСТЬ: Поля для ввода -->
                <Border Grid.Column="0" Background="Transparent">
                    <StackPanel>
                        <!-- Группа полей: Токены -->
                        <TextBlock Text="🔐 ТОКЕНЫ"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="0,0,0,10"/>

                        <!-- АТС access token -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="АТС access token"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,5"/>

                            <Border Grid.Row="1"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    Background="#0A0A0A"
                                    Height="35"
                                    CornerRadius="3">
                                <TextBox x:Name="AccessTokenBox"
                                         Text="{Binding AtsToken, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             Foreground="#FFFFFF"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0,10,0"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- АТС refresh token -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       IsEnabled="{Binding HasAtsRefreshToken, UpdateSourceTrigger=PropertyChanged}"
                                       Text="АТС refresh token"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,5"/>

                            <Border Grid.Row="1"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    Background="#0A0A0A"
                                    Height="35"
                                    CornerRadius="3">
                                <TextBox x:Name="RefreshTokenBox"
                                         IsEnabled="{Binding HasAtsRefreshToken, UpdateSourceTrigger=PropertyChanged}"
                                         Text="{Binding AtsRefreshToken, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             Foreground="#FFFFFF"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0,10,0"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- Бот токен -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Чат-бот токен"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,5"/>

                            <Border Grid.Row="1"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    Background="#0A0A0A"
                                    Height="35"
                                    CornerRadius="3">
                                <TextBox x:Name="BotTokenBox"
                                         Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             Foreground="#FFFFFF"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0,10,0"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- Разделитель -->
                        <Rectangle Height="1" Fill="#333333" Margin="0,15,0,15"/>

                        <!-- Расписание -->
                        <TextBlock Text="⏰ РАСПИСАНИЕ"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="0,0,0,10"/>

                        <ComboBox x:Name="ScheduleComboBox"
                          Grid.Column="1"
                          Width="200"
                          Height="35"
                          FontFamily="Segoe UI"
                          FontSize="16"
                          Foreground="#FFFFFF"
                          ItemsSource="{Binding ScheduleItems}"
                          SelectedItem="{Binding SelectedSchedule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="ScheduleComboBox_SelectionChanged"
                          HorizontalAlignment="Left"
                          Cursor="Hand">
                            <!-- Исправленный шаблон для элементов - убран отдельный Background -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" 
                       Foreground="#FFFFFF" 
                       Padding="10,5"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                            <!-- Исправленный стиль контейнера элементов -->
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#000000"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="10,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#1A1A1A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <!-- Разделитель -->
                        <Rectangle Height="1" Fill="#333333" Margin="0,30,0,15"/>
                        
                        <!-- Расписание -->
                        <TextBlock Text="👥 КОНТАКТЫ"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Email" Text="perfecto.calls@gmail.com" 
                               Foreground="#FFFFFF" 
                               Background="Transparent"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               Cursor="Hand"
                               TextDecorations="Underline"
                               MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                               />
                            <TextBlock x:Name="CopyEmailMessage" 
                                       FontSize="16"
                                       Margin="10, 0,0,0"
                                       VerticalAlignment="Center"
                               Foreground="DarkGreen" 
                               Background="Transparent"                                       
                                       Text="скопировано" 
                                       Opacity="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Разделитель -->
                <Border Grid.Column="1"
                        Background="#333333"
                        Width="1"
                        VerticalAlignment="Stretch"/>

                <!-- ПРАВАЯ ЧАСТЬ: Статусы и кнопка -->
                <Border Grid.Column="2" Background="Transparent">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0">
                            <!-- Список статусов -->
                            <TextBlock Text="📊 СТАТУС"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#888888"
                                       Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Подключена АТС -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="AtsStatusIndicator" 
                                             Grid.Column="0"
                                             Width="10" Height="10" 
                                             Fill="#999999" 
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Подключена АТС"
                                               FontFamily="Segoe UI"
                                               FontSize="16"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Настроены сообщения -->
                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="MessagesStatusIndicator" 
                                             Grid.Column="0"
                                             Width="10" Height="10" 
                                             Fill="#999999" 
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Настроены сообщения"
                                               FontFamily="Segoe UI"
                                               FontSize="16"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Подключен Чат-бот -->
                                <Grid Grid.Row="2" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="BotStatusIndicator" 
                                             Grid.Column="0"
                                             Width="10" Height="10" 
                                             Fill="#999999" 
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Подключен Чат-бот"
                                               FontFamily="Segoe UI"
                                               FontSize="16"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Подключена интеграция -->
                                <Grid Grid.Row="3" Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="IntegrationStatusIndicator" 
                                             Grid.Column="0"
                                             Width="10" Height="10" 
                                             Fill="#999999" 
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Подключена интеграция"
                                               FontFamily="Segoe UI"
                                               FontSize="16"
                                               Foreground="#CCCCCC"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        
                            <!-- Разделитель -->
                            <Rectangle Height="1" Fill="#333333" Margin="0,15,0,15"/>
                        
                            <TextBlock Text="🖧 СЕРВЕР"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#888888"
                                       Margin="0,0,0,10"/>

                            <!-- ClientId -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Идентификатор клиента"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,5"/>

                                <Border Grid.Row="1"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        Background="#0A0A0A"
                                        Height="35"
                                        CornerRadius="3">
                                    <TextBox x:Name="ClientId"
                                             Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 FontFamily="Segoe UI"
                                                 FontSize="14"
                                                 Foreground="#FFFFFF"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="10,0,10,0"
                                                 VerticalContentAlignment="Center"
                                                 CaretBrush="#FFFFFF"/>
                                </Border>
                            </Grid>

                            <!-- ClientPassword -->
                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Пароль"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           Foreground="#CCCCCC"
                                           Margin="0,0,0,5"/>

                                <Border Grid.Row="1"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        Background="#0A0A0A"
                                        Height="35"
                                        CornerRadius="3">
                                    <TextBox x:Name="ClientPassword"
                                             Text="{Binding ClientPassword, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                 FontFamily="Segoe UI"
                                                 FontSize="14"
                                                 Foreground="#FFFFFF"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="10,0,10,0"
                                                 VerticalContentAlignment="Center"
                                                 CaretBrush="#FFFFFF"/>
                                </Border>
                            </Grid>

                            <!-- Кнопка Запустить на сервере -->
                            <Button x:Name="RunServerButton"
                                    IsEnabled="{Binding RunServerIsEnabled}"
                                    Visibility="{Binding RunServerVisibility}"
                                    Content="ЗАПУСТИТЬ НА СЕРВЕРЕ"
                                    Height="45"
                                    FontFamily="Segoe UI"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding RunServerForground}"
                                    Background="#1A1A1A"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Margin="0,10,0,0"
                                    Click="RunServerButton_Click">
                            </Button>

                            <!-- Кнопка Запустить на сервере -->
                            <Button x:Name="StopServerButton"
                                    Visibility="{Binding StopServerVisibility}"
                                    Content="ОСТАНОВИТЬ НА СЕРВЕРЕ"
                                    Height="45"
                                    FontFamily="Segoe UI"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#FFFFFF"
                                    Background="#1A1A1A"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Margin="0,10,0,0"
                                    Click="StopServerButton_Click">
                            </Button>
                        </StackPanel>

                        <TextBlock  Grid.Row="1" x:Name="ServerResultMessage" 
                                    Text="{Binding ServerResultMessage, Mode=OneWay}"
                                    Foreground="{Binding ServerResultMessageColor, Mode=OneWay}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Opacity="1"
                                    FontFamily="Segoe UI"
                                    FontSize="16"                                           
                                    Margin="0,0,0,5"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>