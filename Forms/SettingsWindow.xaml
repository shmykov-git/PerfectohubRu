<Window x:Class="MovieIntro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Width="650" Height="550"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="#000000"
                                          BorderBrush="#333333"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Border"
                                                            Background="#000000"
                                                            BorderBrush="#333333"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       x:Name="SelectedText"
                                                                       Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                       Foreground="#FFFFFF"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0"/>
                                                            <Path Grid.Column="1"
                                                                  x:Name="Arrow"
                                                                  Data="M0,0 L5,5 L10,0 Z"
                                                                  Fill="#666666"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,2,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#1A1A1A"/>
                                                            <Setter TargetName="Arrow" Property="Fill" Value="#999999"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <!-- Исправленный Popup с черным фоном -->
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Width="200"
                                   PopupAnimation="Fade">
                                <Border Background="#000000"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                    <ScrollViewer x:Name="ScrollViewer"
                                                  MaxHeight="200"
                                                  Background="#000000"
                                                  BorderThickness="0">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElement"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                            <ContentPresenter 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#333333"/>
                                <Setter TargetName="BorderElement" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.95,0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#000000" Opacity="{TemplateBinding Opacity}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="15"/>
                            </Grid.RowDefinitions>

                            <!-- Верхняя кнопка (вверх) -->
                            <RepeatButton x:Name="DecreaseRepeatButton"
                                  Grid.Row="0"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineUpCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,5 L5,0 L10,5 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>

                            <!-- Track с ползунком -->
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                           Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                   Background="#444444"
                                   BorderBrush="#555555"
                                   BorderThickness="1"
                                   Margin="1,0">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Height" Value="40"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3"
                                                            Margin="1,0"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#666666"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#777777"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#999999"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                            <!-- Нижняя кнопка (вниз) -->
                            <RepeatButton x:Name="IncreaseRepeatButton"
                                  Grid.Row="2"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineDownCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,0 L5,5 L10,0 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" x:Name="OuterCircle" 
                                                                Width="14" Height="14" 
                                                                Stroke="#666666" 
                                                                Fill="Transparent"/>
                            <Ellipse Grid.Column="0" x:Name="InnerCircle" 
                                                                Width="8" Height="8" 
                                                                Fill="#AA3333" 
                                                                Visibility="Collapsed"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"  Content="{TemplateBinding Content}"
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#AA3333"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0A0A0A" 
            BorderBrush="#333333" 
            BorderThickness="1"
            CornerRadius="8">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок с кнопкой закрытия -->
            <Border Grid.Row="0" 
                    Background="#0A0A0A" 
                    CornerRadius="8,8,0,0">
                <Grid>
                    <Border x:Name="TitleBar"
                        Height="40"
                        Background="Transparent"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Stretch"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                    <StackPanel 
                        Orientation="Horizontal" 
                        Margin="15,0,0,0" 
                        VerticalAlignment="Center" 
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <TextBlock Text="⚙" FontSize="16" Foreground="#888888" Margin="0,0,8,0"/>
                        <TextBlock Text="НАСТРОЙКИ" 
                                   FontFamily="Segoe UI"
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Button x:Name="CloseButton"
                            Width="30" Height="30"
                            HorizontalAlignment="Right"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CloseButton_Click">
                        <Button.Content>
                            <Grid Width="12" Height="12">
                                <Line X1="0" Y1="0" X2="12" Y2="12" 
                                      Stroke="#666666" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="12" Y1="0" X2="0" Y2="12" 
                                      Stroke="#666666" StrokeThickness="2" 
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

            <!-- Основное содержимое: две колонки -->
            <Grid Grid.Row="1" Margin="20,15,20,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ЛЕВАЯ ЧАСТЬ: Поля для ввода -->
                <Border Grid.Column="0" Background="Transparent">
                    <StackPanel>
                        <!-- Группа полей: Токены -->
                        <TextBlock Text="🔐 ТОКЕНЫ"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="0,0,0,10"/>

                        <!-- АТС access token -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="АТС access token"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,5"/>

                            <Border Grid.Row="1"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    Background="#0A0A0A"
                                    Height="35"
                                    CornerRadius="3">
                                <TextBox x:Name="AccessTokenBox"
                                         Text="{Binding AtsToken, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             Foreground="#FFFFFF"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0,10,0"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- АТС refresh token -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       IsEnabled="{Binding HasAtsRefreshToken, UpdateSourceTrigger=PropertyChanged}"
                                       Text="АТС refresh token"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,5"/>

                            <Border Grid.Row="1"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    Background="#0A0A0A"
                                    Height="35"
                                    CornerRadius="3">
                                <TextBox x:Name="RefreshTokenBox"
                                         IsEnabled="{Binding HasAtsRefreshToken, UpdateSourceTrigger=PropertyChanged}"
                                         Text="{Binding AtsRefreshToken, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             Foreground="#FFFFFF"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0,10,0"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- Бот токен -->
                        <Grid Margin="0,0,0,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Чат-бот токен"
                                       FontFamily="Segoe UI"
                                       FontSize="16"
                                       Foreground="#CCCCCC"
                                       Margin="0,0,0,5"/>

                            <Border Grid.Row="1"
                                    BorderBrush="#333333"
                                    BorderThickness="1"
                                    Background="#0A0A0A"
                                    Height="35"
                                    CornerRadius="3">
                                <TextBox x:Name="BotTokenBox"
                                         Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             FontFamily="Segoe UI"
                                             FontSize="14"
                                             Foreground="#FFFFFF"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,0,10,0"
                                             VerticalContentAlignment="Center"
                                             CaretBrush="#FFFFFF"/>
                            </Border>
                        </Grid>

                        <!-- Разделитель -->
                        <Rectangle Height="1" Fill="#333333" Margin="0,15,0,15"/>

                        <!-- Расписание -->
                        <TextBlock Text="⏰ РАСПИСАНИЕ"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="0,0,0,10"/>

                        <ComboBox x:Name="ScheduleComboBox"
                          Grid.Column="1"
                          Width="200"
                          Height="35"
                          FontFamily="Segoe UI"
                          FontSize="16"
                          Foreground="#FFFFFF"
                          ItemsSource="{Binding ScheduleItems}"
                          SelectedItem="{Binding SelectedSchedule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          SelectionChanged="ScheduleComboBox_SelectionChanged"
                          HorizontalAlignment="Left"
                          Cursor="Hand">
                            <!-- Исправленный шаблон для элементов - убран отдельный Background -->
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" 
                       Foreground="#FFFFFF" 
                       Padding="10,5"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>

                            <!-- Исправленный стиль контейнера элементов -->
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Background" Value="#000000"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="10,0"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#333333"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="Background" Value="#1A1A1A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>

                        <!-- Разделитель -->
                        <Rectangle Height="1" Fill="#333333" Margin="0,30,0,15"/>
                        
                        <!-- Расписание -->
                        <TextBlock Text="👥 КОНТАКТЫ"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="0,0,0,10"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Email" Text="perfecto.calls@gmail.com" 
                               Foreground="#FFFFFF" 
                               Background="Transparent"
                               FontFamily="Segoe UI"
                               FontSize="16"
                               Cursor="Hand"
                               TextDecorations="Underline"
                               MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                               />
                            <TextBlock x:Name="CopyEmailMessage" 
                                       FontSize="16"
                                       Margin="10, 0,0,0"
                                       VerticalAlignment="Center"
                               Foreground="DarkGreen" 
                               Background="Transparent"                                       
                                       Text="скопировано" 
                                       Opacity="0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Разделитель -->
                <Border Grid.Column="1"
                        Background="#333333"
                        Width="1"
                        VerticalAlignment="Stretch"/>

                <!-- ПРАВАЯ ЧАСТЬ: Статусы и кнопка -->
                <Border Grid.Column="2" Background="Transparent">
                    <StackPanel>
                        <!-- Список статусов -->
                        <TextBlock Text="📊 СТАТУСЫ"
                                   FontFamily="Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#888888"
                                   Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Подключена АТС -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="AtsStatusIndicator" 
                                         Grid.Column="0"
                                         Width="10" Height="10" 
                                         Fill="#999999" 
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Подключена АТС"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Настроены сообщения -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="MessagesStatusIndicator" 
                                         Grid.Column="0"
                                         Width="10" Height="10" 
                                         Fill="#999999" 
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Настроены сообщения"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Подключен Чат-бот -->
                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="BotStatusIndicator" 
                                         Grid.Column="0"
                                         Width="10" Height="10" 
                                         Fill="#999999" 
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Подключен Чат-бот"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Подключена интеграция -->
                            <Grid Grid.Row="3" Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Ellipse x:Name="IntegrationStatusIndicator" 
                                         Grid.Column="0"
                                         Width="10" Height="10" 
                                         Fill="#999999" 
                                         Margin="0,0,10,0"
                                         VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Подключена интеграция"
                                           FontFamily="Segoe UI"
                                           FontSize="16"
                                           Foreground="#CCCCCC"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Кнопка Запустить на сервере -->
                        <Button x:Name="RunServerButton"
                                IsEnabled="{Binding RunServerIsEnabled}"
                                Visibility="{Binding RunServerVisibility}"
                                Content="🖧 ЗАПУСТИТЬ НА СЕРВЕРЕ"
                                Height="45"
                                FontFamily="Segoe UI"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{Binding RunServerForground}"
                                Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Cursor="Hand"
                                Margin="0,10,0,0"
                                Click="RunServerButton_Click">
                        </Button>

                        <!-- Кнопка Запустить на сервере -->
                        <Button x:Name="StopServerButton"
                                Visibility="{Binding StopServerVisibility}"
                                Content="🖧 ОСТАНОВИТЬ НА СЕРВЕРЕ"
                                Height="45"
                                FontFamily="Segoe UI"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FFFFFF"
                                Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1"
                                Cursor="Hand"
                                Margin="0,10,0,0"
                                Click="RunServerButton_Click">
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>