<Application x:Class="PerfectohubRu.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PerfectohubRu">
    <Application.Resources>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Background="#000000"
                                          BorderBrush="#333333"
                                          BorderThickness="1"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="Border"
                                                            Background="#000000"
                                                            BorderBrush="#333333"
                                                            BorderThickness="1"
                                                            CornerRadius="3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="30"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       x:Name="SelectedText"
                                                                       Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                       Foreground="#FFFFFF"
                                                                       VerticalAlignment="Center"
                                                                       Margin="10,0,0,0"/>
                                                            <Path Grid.Column="1"
                                                                  x:Name="Arrow"
                                                                  Data="M0,0 L5,5 L10,0 Z"
                                                                  Fill="#666666"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Margin="0,2,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Border" Property="Background" Value="#1A1A1A"/>
                                                            <Setter TargetName="Arrow" Property="Fill" Value="#999999"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>

                            <!-- Исправленный Popup с черным фоном -->
                            <Popup x:Name="Popup"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Width="200"
                                   PopupAnimation="Fade">
                                <Border Background="#000000"
                                        BorderBrush="#333333"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Margin="0,2,0,0">
                                    <ScrollViewer x:Name="ScrollViewer"
                                                  MaxHeight="200"
                                                  Background="#000000"
                                                  BorderThickness="0">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BorderElement"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="3">
                            <ContentPresenter 
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BorderElement" Property="Background" Value="#333333"/>
                                <Setter TargetName="BorderElement" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A0A0A"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="RenderTransformOrigin" Value="0.95,0.95"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinHeight" Value="10"/>
            <Setter Property="Background" Value="#000000"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="#000000" Opacity="{TemplateBinding Opacity}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="15"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="15"/>
                            </Grid.RowDefinitions>

                            <!-- Верхняя кнопка (вверх) -->
                            <RepeatButton x:Name="DecreaseRepeatButton"
                                  Grid.Row="0"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineUpCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,5 L5,0 L10,5 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>

                            <!-- Track с ползунком -->
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                           Grid.Row="1">
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb"
                                   Background="#444444"
                                   BorderBrush="#555555"
                                   BorderThickness="1"
                                   Margin="1,0">
                                        <Thumb.Style>
                                            <Style TargetType="Thumb">
                                                <Setter Property="Height" Value="40"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border x:Name="ThumbBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="3"
                                                            Margin="1,0"/>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#666666"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#777777"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="#999999"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>

                            <!-- Нижняя кнопка (вниз) -->
                            <RepeatButton x:Name="IncreaseRepeatButton"
                                  Grid.Row="2"
                                  Background="#1A1A1A"
                                  BorderBrush="#333333"
                                  BorderThickness="1"
                                  Focusable="False"
                                  Command="ScrollBar.LineDownCommand">
                                <Border Background="#1A1A1A"
                                BorderBrush="#333333"
                                BorderThickness="1">
                                    <Path Data="M0,0 L5,5 L10,0 Z"
                                  Fill="#666666"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="8"
                                  Height="8"/>
                                </Border>
                            </RepeatButton>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type RadioButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" x:Name="OuterCircle" 
                                                                Width="14" Height="14" 
                                                                Stroke="#666666" 
                                                                Fill="Transparent"/>
                            <Ellipse Grid.Column="0" x:Name="InnerCircle" 
                                                                Width="8" Height="8" 
                                                                Fill="#AA3333" 
                                                                Visibility="Collapsed"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"/>
                            <ContentPresenter Grid.Column="1"  Content="{TemplateBinding Content}"
                                                                        Margin="10,0,0,0"
                                                                        VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#AA3333"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>         
    </Application.Resources>
</Application>
