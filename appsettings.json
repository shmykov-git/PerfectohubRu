{
  "Client": {
    "KnownMarks": "🔒-Lock,+-Plus,🛇-Stop,🗸-CheckLight,!-Exclamation,⮜-BackArrow,◄-BackArrowLight,🔁-Repeat,‼-DoubleExclamation,✔-Check",
