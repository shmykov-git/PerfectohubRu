{
  "HttpClients": {
    "BeelineAtsApi": {
      "Host": "https://cloudpbx.beeline.ru",
      "ClientTimeout": 60,
      "UseCache": true,
      "CacheType": "OnDisk", // OnDisk, InMemory
      "MaxParallelRequestsCount": 20,
      "MaxFileReadsCount": 5,
      "GetCalls": {
        "MethodApi": "/napis/v3/statistics/recordsChart",
        "RequestTimeout": 60,
        "DebugContentLimit": 150
      },
      "GetAbonents": {
        "MethodApi": "/apis/portal/abonents",
        "RequestTimeout": 60
      },
      "Limit": 10000
    },
    "Tele2AtsApi": {
      "Host": "https://ats2.t2.ru",
      "ClientTimeout": 700,
      "UseCache": true,
      "CacheType": "OnDisk", // OnDisk, InMemory
      "MaxParallelRequestsCount": 2,
      "MaxFileReadsCount": 5,
      "RefreshToken": {
        "MethodApi": "/crm/openapi/authorization/refresh/token",
        "RequestTimeout": 20,
        "RetryCount": 30,
        "RetryTimeout": 1
      },
      "GetCalls": {
        "MethodApi": "/crm/openapi/call-records/info",
        "RequestTimeout": 5,
        "RetryCount": 100,
        "RetryTimeout": 1,
        "DebugContentLimit": 150
      },
      "GetAbonents": {
        "MethodApi": "/crm/openapi/employees",
        "RequestTimeout": 5,
        "RetryCount": 100,
        "RetryTimeout": 1
      },
      "Limit": 10000
    },
    "CallsApi": {
      "ClientTimeout": 60,
      "RegisterClient": {
        "MethodApi": "/clients/register"
      }
    }
  }
}
